# Sample environment configuration for Dubplate Authenticator

# Database
DATABASE_URL=sqlite:///dubplate_auth.db

# Audio Processing
SAMPLE_RATE=22050
HOP_LENGTH=512

# AI Detection
AI_SENSITIVITY=0.7

# Watermarking
SECRET_KEY=your_secret_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=false

# File Upload
MAX_FILE_SIZE=52428800
